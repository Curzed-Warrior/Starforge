<Project Sdk="Microsoft.NET.Sdk">
  <!-- The simulation and its self-tests without the Godot engine: a stand-in for the few Godot types the
       simulation uses (GodotShim.cs). Lets CI and cloud sessions run the self-tests, traces and save test.
       See tools/headless/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Starforge</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0108;CS0169;CS0414;CS0649</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Sim/**/*.cs" />
    <Compile Include="../../src/Tests/**/*.cs" />
  </ItemGroup>
</Project>
